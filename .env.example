# Copy this file to .env and put your own values in it.
# .env is listed in .gitignore, so your real password never gets uploaded.
SMTP_EMAIL=your_address@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Admin dashboard login. Choose your own username and a strong password.
ADMIN_USERNAME=your_admin_name
ADMIN_PASSWORD=choose_a_strong_password
